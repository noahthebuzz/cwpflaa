# Database
DATABASE_URL=postgresql+asyncpg://puzzleuser:puzzlepass@db:5432/puzzledb
POSTGRES_USER=puzzleuser
POSTGRES_PASSWORD=puzzlepass
POSTGRES_DB=puzzledb

# Auth
SECRET_KEY=your-very-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
